# ─── Algorand Testnet Configuration ────────────────────────────
# MediTrace Contracts — Algorand deployment environment

NETWORK=testnet

# ── Algorand Node (Testnet via AlgoNode — free, no API key) ────
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=

# ── Indexer (Testnet via AlgoNode) ─────────────────────────────
INDEXER_SERVER=https://testnet-idx.algonode.cloud
INDEXER_PORT=443
INDEXER_TOKEN=

# ── Deployer Account ──────────────────────────────────────────
# 25-word Algorand mnemonic for the deployer account.
DEPLOYER_MNEMONIC=""

# ── Role Addresses (optional — defaults to deployer) ──────────
MANUFACTURER_ADDRESS=
DISTRIBUTOR_ADDRESS=
PHARMACY_ADDRESS=
TELEMETRY_ORACLE_ADDRESS=
