          "name": "role",
          "type": "uint64"
        },
        {
          "name": "account",
          "type": "address"
        }
      ],
      "returns": {
        "type": "void"
      }
    },
    {
      "name": "revokeRole",
      "desc": "Revoke a role bitmask from an account. Admin-only.",
      "args": [
        {
          "name": "role",
          "type": "uint64"
        },
        {
          "name": "account",
          "type": "address"
        }
      ],
      "returns": {
        "type": "void"
      }
    },
    {
      "name": "grantManufacturerRole",
