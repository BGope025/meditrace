        }
      ],
      "returns": {
        "type": "void"
      }
    },
    {
      "name": "revokeManufacturerRole",
      "args": [
        {
          "name": "account",
          "type": "address"
        }
      ],
      "returns": {
        "type": "void"
      }
    },
    {
      "name": "revokeDistributorRole",
      "args": [
        {
          "name": "account",
          "type": "address"
        }
      ],
      "returns": {
        "type": "void"
      }
    },
    {
      "name": "revokePharmacyRole",
      "args": [
        {
          "name": "account",
          "type": "address"
        }
      ],
      "returns": {
        "type": "void"
      }
